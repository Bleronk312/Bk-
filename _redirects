# ============================================================================
# Kurz-Adressen. Reihenfolge zaehlt: die erste passende Regel gewinnt.
# ============================================================================
# Das "!" am Ende erzwingt die Regel auch dann, wenn es eine Datei gleichen
# Namens gibt. Ohne das wuerde /admin bei Netlify von selbst auf admin.html
# zeigen - und das ist die Graffiti-App, nicht die Verwaltung.

# Die nackte Adresse gehoert den Mitarbeitern. Sie ist die, die man am Telefon
# durchgibt und auf einen Zettel schreibt, deshalb muss sie ohne Zusatz dort
# landen, wo gearbeitet wird. 200 statt 301: die Adresse bleibt gekoapp.com
# stehen, es wird nur GEKO One ausgeliefert.
/           /meine.html     200!

# Verwaltung: der Hub mit allen Abteilungen.
/admin      /hub.html       200!

# Bewusst KEINE eigene Kurz-Adresse fuer die einzelnen Abteilungen (Graffiti,
# Glas, Lager, Check-ins). Es gibt genau zwei Eingaenge - GEKO One fuer die
# Mitarbeiter, den Hub fuer die Verwaltung -, alles andere ist ein Baustein
# dahinter. Jeder zusaetzliche Einstieg bedeutet nur, dass jemand irgendwo
# landet, wo er nicht hinwollte.

# Installations-Anleitung fuers Handy (Schritt fuer Schritt, mit Bildern).
# Das ist der Link fuer alle, die zum ersten Mal dabei sind.
/app        /install.html   200

# Alter Kurzlink auf GEKO One - bleibt bestehen, damit schon verschickte
# Nachrichten weiter funktionieren.
/start      /meine.html     200
